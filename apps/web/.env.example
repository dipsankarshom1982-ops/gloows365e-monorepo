# Copy this to .env.local and fill in your values. Never put real
# credentials in this file (.env.example) — it's the one env file meant to
# be committed.

# Firebase (client-side config — these are not secrets; Firebase's web SDK
# config is designed to be public/bundled, see Firebase's own docs)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare Stream
NEXT_PUBLIC_CF_CUSTOMER_CODE=
NEXT_PUBLIC_CF_WORKER_URL=

# Razorpay — PUBLIC key ID only. The secret (RAZORPAY_KEY_SECRET) must
# never appear in this app; it lives only in Cloud Functions' Secret
# Manager-backed env (see functions/.env.example).
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id_here

# Cloud Functions URL
NEXT_PUBLIC_CLOUD_FUNCTION_URL=
