# apps/tutor/.env
# Same Firebase project as apps/web/apps/mobile (gloows-03b6sz) — deliberate,
# see the Phase 1a plan's architecture notes: a verified tutor's profile has
# to surface inside the existing Gloows365E Tutor Marketplace, which
# requires sharing the same project/Firestore instance, not an isolated one
# like the "365" apps use.
#
# Reusing apps/web's exact Firebase Web App config values — functionally
# fine (same project, Auth/Firestore/Storage security comes from rules, not
# from this key being secret). Registering tutor.gloows365.in as its own
# Firebase Web App (for a separate Analytics stream) is a later, purely
# cosmetic follow-up, not a functional requirement.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCpS6KjmnGAD5vCuB_swM2SWRd6-nhoiys
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gloows-03b6sz.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gloows-03b6sz
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gloows-03b6sz.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1039247674814
NEXT_PUBLIC_FIREBASE_APP_ID=1:1039247674814:web:071d5c2982065f6712bdef
