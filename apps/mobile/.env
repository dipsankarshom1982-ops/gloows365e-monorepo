# Google OAuth — get these from Firebase Console → Authentication → Google → Web SDK config
# Android/iOS client IDs from Google Cloud Console → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# AI Guru — Cloud Function base URL
EXPO_PUBLIC_CLOUD_FUNCTION_URL=https://us-central1-gloows-03b6sz.cloudfunctions.net
EXPO_PUBLIC_GENERATE_LESSON_URL= https://us-central1-gloows-03b6sz.cloudfunctions.net/generateLesson
EXPO_PUBLIC_FOLLOWUP_URL=https://us-central1-gloows-03b6sz.cloudfunctions.net/followUp

# Cloudflare Stream — app-side config
# These are NOT secrets (they're embedded in the app bundle).
# API token and account ID stay as Worker secrets in Cloudflare dashboard.

# Your deployed Worker URL (from cloudflare-worker.js)
# e.g. https://vidya-stream.your-subdomain.workers.dev
EXPO_PUBLIC_CF_WORKER_URL=https://vidya-stream.dipsankarshom1982.workers.dev

# Customer subdomain from CF Stream dashboard → Overview
# e.g. if your playback URL is customer-abc123.cloudflarestream.com  →  abc123
EXPO_PUBLIC_CF_CUSTOMER_CODE=cif09s9962jkfc36
# Razorpay — get from https://dashboard.razorpay.com → Settings → API Keys
# Switch to TEST MODE in Razorpay dashboard before copying keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_SyluFsSSm0Ghbh


