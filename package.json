{
  "name": "gloows365e-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin-web dev",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin-web build",
    "build:shared": "pnpm --filter @gloows/shared-logic build",
    "deploy:web": "pnpm build:web && firebase deploy --only hosting:web",
    "deploy:admin": "pnpm build:admin && firebase deploy --only hosting:admin",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "pnpm build:web && pnpm build:admin && firebase deploy"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
