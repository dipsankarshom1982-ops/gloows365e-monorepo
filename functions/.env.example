# Razorpay credentials used by functions/src/{tutorCredits,aiGuruCredits,
# aiGuruSubscription,seekho,bookingPayment,razorpayWebhook}.ts.
#
# IMPORTANT — this file is a REFERENCE ONLY, not a file this project
# actually loads at runtime. These three Cloud Functions secrets are bound
# via `.runWith({ secrets: [...] })` / `{ secrets: [...] }` in each
# function's config and are read from Google Cloud Secret Manager at
# invocation time (`process.env["RAZORPAY_KEY_ID"]`, etc.) — never from a
# functions/.env file, in production or in the emulator. Do NOT create a
# real functions/.env with live values; it would not be picked up in prod
# and would be one more place a secret could accidentally get committed.
#
# To set the real values, run (once per environment — staging vs. prod
# project):
#   firebase use <project-id>
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# Each prompts for the value on stdin — never pass it as a CLI argument
# (that would land in your shell history). Get the values from the
# Razorpay Dashboard → Settings → API Keys (Key ID/Secret) and →
# Webhooks → your webhook's configured secret (Webhook Secret).

RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─────────────────────────────────────────────────────────────────────────
# WORKER_OWNERSHIP_SECRET — used by functions/src/mediaOwnership.ts, bound
# via .runWith({ secrets: [...] }) in createBattleSubmission
# (battleSubmissions.ts) and submitSkillBattleReel (skillBattleSubmission.ts).
#
# 2026-09-11 audit P0 fix: the Cloudflare Stream upload Worker
# (apps/mobile/cloudflare-worker.js) now requires a verified Firebase ID
# token before issuing an upload, and mints a short-lived HMAC-signed
# token binding {uid, videoUid} — WORKER_OWNERSHIP_SECRET is the ONE
# secret shared between that Worker and these two Cloud Functions to
# verify that token. It is NOT a Cloudflare API credential and grants no
# access to Cloudflare or Firebase — it only signs/verifies this one
# narrow ownership claim. Generate once (e.g. `openssl rand -base64 32`)
# and set the IDENTICAL value in BOTH places:
#   1. Cloud Functions:
#      firebase use <project-id>
#      firebase functions:secrets:set WORKER_OWNERSHIP_SECRET
#   2. The Cloudflare Worker dashboard (Workers & Pages → the "vidya-stream"
#      worker → Settings → Variables → add WORKER_OWNERSHIP_SECRET as a
#      "Secret", not a plaintext env var).
# A mismatched secret between the two makes every submission fail CLOSED
# (rejected), never fail open — see mediaOwnership.ts's
# server_misconfigured/bad_signature handling.

WORKER_OWNERSHIP_SECRET=your_shared_worker_ownership_secret_here

# ─────────────────────────────────────────────────────────────────────────
# SKILL BATTLE VIDEO MODERATION / COPYRIGHT PIPELINE (Phase A)
#
# NONE of these are configured in this environment. The moderation
# pipeline (functions/src/moderation/) is fully wired into
# createBattleSubmission and submitSkillBattleReel, but every provider
# below is an Unconfigured*Provider stub that returns NOT_CONFIGURED
# instead of pretending a check happened — see each provider file's
# header (functions/src/moderation/videoModerationProvider.ts,
# copyrightDetectionProvider.ts, videoSimilarityProvider.ts) for exactly
# what real infrastructure/credentials each one needs before it can be
# switched on, and why none of that is done yet.
#
# AWS Rekognition Video (visual safety moderation — NOT active):
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# IAM role Rekognition assumes to read the source video (which must live
# in S3 — Rekognition Video cannot read a Cloudflare Stream URL directly;
# see videoModerationProvider.ts's header for the ingestion-pipeline gap
# this still needs).
AWS_REKOGNITION_ROLE_ARN=
#
# Copyright detection (audio fingerprint match — NOT active, no vendor
# has been selected):
COPYRIGHT_PROVIDER=
COPYRIGHT_API_KEY=
COPYRIGHT_API_SECRET=
#
# Decision engine thresholds (functions/src/moderation/decisionEngine.ts)
# — safe defaults are used if unset; override only with an actual policy
# decision behind you, not a guess.
MODERATION_HIGH_THRESHOLD=90
MODERATION_REVIEW_THRESHOLD=60
# Both OFF by default — turning either on is a product/legal policy
# decision, not a technical one. With both false, every submission (even
# once real providers are wired in and return a clean LOW_RISK or a
# clear HIGH_RISK) still lands in PENDING_HUMAN_REVIEW; a human stays in
# the loop until the product explicitly opts out for one direction.
AUTO_REJECT_HIGH_RISK=false
AUTO_APPROVE_LOW_RISK=false

# ─────────────────────────────────────────────────────────────────────────
# SKILL BATTLE MODERATION — PHASE C (real async provider pipeline)
#
# NONE of these are configured in this environment either — see the Phase
# C implementation report's "B. Provider capability verification" section
# for exactly what is/isn't verified about each. Leaving VIDEO_MODERATION_
# PROVIDER / COPYRIGHT_PROVIDER / VIDEO_SIMILARITY_PROVIDER unset (or any
# value other than the ones below) keeps every check on the same
# NOT_CONFIGURED/UNKNOWN/NOT_CHECKED fail-closed defaults as Phase A.
#
# Visual safety — Sightengine (functions/src/moderation/
# videoModerationProvider.ts's SightengineVideoModerationProvider):
VIDEO_MODERATION_PROVIDER=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Category models to run — see Sightengine's own docs for the current,
# authoritative list; the default in providerConfig.ts has NOT been
# independently verified against a live account.
SIGHTENGINE_MODELS=
# The publicly reachable URL of the deployed handleSightengineCallback
# function (known only after first deploy — see index.ts).
SIGHTENGINE_CALLBACK_URL=
# The endpoint's own signing secret, from the Sightengine dashboard
# (prefixed casec_) — used to verify Sightengine-Signature on inbound
# callbacks. NOT the same value as SIGHTENGINE_API_SECRET.
SIGHTENGINE_CALLBACK_SIGNING_SECRET=
#
# Copyright/audio — ACRCloud (functions/src/moderation/
# copyrightDetectionProvider.ts's AcrCloudCopyrightDetectionProvider):
COPYRIGHT_PROVIDER=
# e.g. identify-ap-southeast-1.acrcloud.com — confirm the recommended
# region for an India-based account with ACRCloud directly.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# 0-100 — a music match at/above this ACRCloud confidence score is
# reported CONFIRMED_MATCH, below it POSSIBLE_MATCH. Not independently
# tuned; 80 is a starting point, not a validated threshold.
ACRCLOUD_MATCH_CONFIDENCE_THRESHOLD=80
#
# Duplicate/re-upload similarity — in-house perceptual hash against
# Cloudflare Stream's own thumbnails (functions/src/moderation/
# videoSimilarityProvider.ts's CloudflareThumbnailSimilarityProvider) —
# no third-party credentials needed, only the flag to turn it on:
VIDEO_SIMILARITY_PROVIDER=
# Average per-frame Hamming distance (0-64) at/under which two videos in
# the same battle are flagged HIGH_SIMILARITY. Not calibrated against a
# real corpus of known duplicate/non-duplicate pairs.
SIMILARITY_HAMMING_THRESHOLD=10
#
# Cloudflare Stream — the SAME account/credentials already configured in
# the upload Worker's OWN environment (apps/mobile/cloudflare-worker.js's
# env.CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_API_TOKEN/CLOUDFLARE_CUSTOMER_
# SUBDOMAIN), but that's a separate Cloudflare Workers runtime with its
# own separate env store — these values must be independently provisioned
# into Cloud Functions' own secrets too; setting them in the Worker's
# dashboard does not make them available here.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CUSTOMER_SUBDOMAIN=
# The webhook subscription's own signing secret (from creating/reading
# the webhook via `PUT/GET /accounts/{id}/stream/webhook` — see
# streamWebhook.ts's header for why this is a one-time administrative
# action, not something Cloud Functions does to itself).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
