# Razorpay credentials used by functions/src/{tutorCredits,aiGuruCredits,
# aiGuruSubscription,seekho,bookingPayment,razorpayWebhook}.ts.
#
# IMPORTANT — this file is a REFERENCE ONLY, not a file this project
# actually loads at runtime. These three Cloud Functions secrets are bound
# via `.runWith({ secrets: [...] })` / `{ secrets: [...] }` in each
# function's config and are read from Google Cloud Secret Manager at
# invocation time (`process.env["RAZORPAY_KEY_ID"]`, etc.) — never from a
# functions/.env file, in production or in the emulator. Do NOT create a
# real functions/.env with live values; it would not be picked up in prod
# and would be one more place a secret could accidentally get committed.
#
# To set the real values, run (once per environment — staging vs. prod
# project):
#   firebase use <project-id>
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
# Each prompts for the value on stdin — never pass it as a CLI argument
# (that would land in your shell history). Get the values from the
# Razorpay Dashboard → Settings → API Keys (Key ID/Secret) and →
# Webhooks → your webhook's configured secret (Webhook Secret).

RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
