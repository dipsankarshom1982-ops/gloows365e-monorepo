rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 STUDENTS PROFILE
    match /students/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow create, update, delete: if request.auth.uid == userId;
    }

    // 🔥 POSTS
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && (
          request.auth.token.admin == true
          || (
            request.resource.data.userId == resource.data.userId
            && (
              request.auth.uid == resource.data.userId
              || request.resource.data.diff(resource.data).changedKeys().hasOnly([
                'views', 'likes', 'comments', 'watchTime', 'shares'
              ])
            )
          )
        );
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == userId;
      }
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }

    // 👤 USERS — all profile types (student, restartEducation, parent)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId
        && !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'vCoins', 'vCoinsLifetimeEarned', 'vCoinsLifetimeSpent',
          'vCoinsYear_2024','vCoinsYear_2025','vCoinsYear_2026','vCoinsYear_2027','vCoinsYear_2028',
          'vCoinsHistory_2024','vCoinsHistory_2025','vCoinsHistory_2026','vCoinsHistory_2027','vCoinsHistory_2028'
        ]);
      allow update: if request.auth.token.admin == true;
      allow delete: if false;

      // ✅ FIX: Clients can no longer write transaction docs directly.
      // All vCoinTransactions are written only by Cloud Functions (Admin SDK).
      match /vCoinTransactions/{txId} {
        allow read:                   if request.auth.uid == userId;
        allow create, update, delete: if false;
      }
      match /vCoinActivityLocks/{lockId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 📋 V-COIN RULES
    match /vCoinRules/{ruleId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🤖 AI CHATS (student AI Guru)
    match /aiChats/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /messages/{messageId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 📓 AI NOTEBOOK — saved Q&A entries
    match /aiNotebook/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /entries/{entryId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 🎓 RESTART EDUCATION CHATS (separate from AI Guru)
    match /restartEducationChats/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // 📋 EDUCATION LEADS
    match /educationLeads/{leadId} {
      // Users can create their own leads
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      // Users can read their own leads
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
      // Only admin can update (status, partner, notes)
      allow update: if request.auth.token.admin == true;
      allow delete: if false;
    }

    // 🎓 EDUCATION PATHWAYS (admin writes, all authenticated read)
    match /educationPathways/{pathwayId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🎯 EDUCATION OPPORTUNITIES (admin writes, all authenticated read)
    // Was missing entirely — every read fell through Firestore's default
    // deny-all, so apps/mobile/app/restart-education/opportunities.tsx's
    // onSnapshot listener always errored and silently showed its hardcoded
    // fallback list forever, no matter what admin configured.
    match /educationOpportunities/{opportunityId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🌟 RESTART SUCCESS STORIES (admin writes, all authenticated read)
    // Same gap as educationOpportunities above, for success-stories.tsx.
    match /restartSuccessStories/{storyId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🔖 BOOKMARKS
    match /bookmarks/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /saved/{bookmarkId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 🏆 SKILLBOARD
    match /skillboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 🎯 BANNERS
    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🏁 CONTESTS
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth.token.admin == true;
      allow update: if request.auth.token.admin == true
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['joinedCount', 'updatedAt'])
          && request.resource.data.joinedCount == resource.data.joinedCount + 1
          && request.resource.data.joinedCount <= resource.data.totalSpots
        );
      match /participant/{userId} {
        allow read: if request.auth != null;
        // Creation only happens through the joinVidyastarContest Cloud
        // Function (Admin SDK, bypasses these rules) — it's the only place
        // that verifies the V-Coins entry fee was actually paid. Direct
        // client create used to be allowed here with no validation on
        // entryFeePaid/sponsored, so any signed-in user could write
        // themselves a free "joined" doc for any paid contest.
        allow create: if false;
        // Updates (quiz answers, score, rank, completed) only happen
        // through the submitVidyastarContestQuiz Cloud Function now too —
        // it has to write EVERY participant's rank in one batch when a
        // quiz is submitted, which a same-uid-only rule can never allow
        // for docs other than the submitter's own (Firestore batches are
        // all-or-nothing, so that cross-user write used to fail the whole
        // batch — see submitVidyastarContestQuiz.ts for the full story).
        allow update: if false;
      }
      match /lessons/{language} {
        // Lesson content is generated lazily per (contest, language) by the
        // getContestLesson Cloud Function (Admin SDK, bypasses these rules)
        // the first time a student in that language opens the lesson —
        // never written directly by a client, same reason participant
        // writes are Cloud-Function-only above.
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ⭐ VIDYASTAR CONFIG — rank-tier prizes per period, keyed by periodKey.
    // Was missing entirely — every read/write fell through Firestore's
    // default deny-all, so the admin's VidyaStar Config page and the
    // student-facing prize displays (contest cards, results) that read this
    // collection directly by periodKey all silently failed.
    match /vidyastarConfig/{periodKey} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🧠 QUIZZES
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
      match /questions/{questionId} {
        allow read: if request.auth != null;
        allow write: if request.auth.token.admin == true;
      }
    }

    match /{path=**}/participant/{userId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ✍️ ATTEMPTS
    match /attempts/{attemptId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.contestId is string
        && request.resource.data.answers is list;
      allow update, delete: if request.auth.token.admin == true;
    }

    // 📖 STORIES
    match /stories/{storyId} {
      allow read: if request.auth != null
        && (resource.data.status == "approved" || request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow create: if request.auth != null
        && (
          request.resource.data.userId == request.auth.uid
          || request.auth.token.admin == true
        );
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }

    // ⚔️ SKILL BATTLES
    match /skillBattles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth.token.admin == true;
      allow update: if request.auth.token.admin == true
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'participants', 'participantCount', 'joinedCount'
          ])
        );
      allow delete: if request.auth.token.admin == true;
    }

    // 🤝 PARTNERS
    match /partners/{partnerId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 🎮 LEARNFUN
    match /dailyFunLearnMissions/{missionId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /LearnFunGames/{gameId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /LearnFunBadges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 🏆 STARBOARD — was missing entirely, so every read from Starboard
    // (web/mobile leaderboard screens, admin's StarboardPayouts.tsx) fell
    // through Firestore's default deny-all, even though the points
    // themselves were being written correctly by
    // submitVidyastarContestQuiz's syncToStarboard() (Admin SDK, bypasses
    // rules). Same shape as the vidyastarConfig gap fixed earlier — the
    // data existed, only the read rule was missing. Write is admin-only:
    // the Cloud Function above doesn't need this rule (Admin SDK bypasses
    // it), but StarboardPayouts.tsx writes lastPayoutLabel/lastPayoutPrize
    // back to these same docs via the regular client SDK as an admin user.
    match /leaderboard/{tab}/entries/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /leaderboards/{tab}/{scope}/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /studentLearnFunProgress/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /missions/{missionId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 🔥 DAILY STREAK QUIZ — NEW
    // Questions: admin-authored question bank. Students never read this
    // directly — they get today's question via the getTodaysStreakQuizQuestion
    // Cloud Function, which strips correctOption/explanation before
    // returning. So this collection is admin-only, full stop.
    match /dailyStreakQuizQuestions/{questionId} {
      allow read, write: if request.auth.token.admin == true;

      // AI-translated versions of the (always-English) question above —
      // generated lazily per language by getTodaysStreakQuizQuestion
      // (Admin SDK, bypasses this rule). Same admin-only posture as the
      // parent: students never read this directly, only via the callable's
      // response, same reason correctOption/explanation are never exposed
      // pre-submission on the parent doc either.
      match /translations/{language} {
        allow read, write: if request.auth.token.admin == true;
      }
    }
    // Progress: per-student streak/weekly-progress/completed-weeks rollup,
    // written only by the submitDailyStreakQuizAnswer / applyForAmbassadorProgram
    // Cloud Functions (Admin SDK, bypasses these rules). Students may read
    // their own doc to drive the stats header; never write it directly —
    // that's how "one submission per day" and the streak math stay
    // tamper-proof.
    match /studentDailyStreakProgress/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if false;
      match /days/{date} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
        allow write: if false;
      }
    }

    // 🔔 NOTIFICATIONS
    match /notifications/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /items/{itemId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // 📺 VIDEOS
    match /seekhoVideos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /short_reels/{reelId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /knowledgeVideos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 📢 ADS
    match /homeAds/{adId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /ads/{adId} {
      allow read: if request.auth != null
        && resource.data.isActive == true
        && resource.data.isApproved == true;
      allow write: if request.auth.token.admin == true;
    }
    match /adAnalytics/{adId} {
      allow read: if request.auth.token.admin == true;
      allow write: if false;
      match /events/{eventId} {
        allow read:   if request.auth.token.admin == true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /adFrequency/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /shikshaStars/{starId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /dashboard/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // 🎓 AI GURU LESSONS
    match /aiGuruLessons/{lessonId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "generating";
      allow update, delete: if false;
      match /quizAttempts/{attemptId} {
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/aiGuruLessons/$(lessonId)).data.uid;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /aiGuruUsage/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
      match /daily/{date} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /subscriptions/{uid} {
      allow read: if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
    }

    // 🎫 AI GURU CREDITS — pay-as-you-go, coexists with subscriptions above.
    // Balance + ledger are Admin-SDK-only, same reasoning as vCoinTransactions:
    // every mutation goes through aiGuruCreditDebit.ts / aiGuruCredits.ts
    // Cloud Functions so a client can never grant or spend its own credits.
    match /aiGuruCredits/{uid} {
      allow read:  if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
      match /transactions/{txId} {
        allow read:                   if request.auth.uid == uid || request.auth.token.admin == true;
        allow create, update, delete: if false;
      }
    }
    match /aiGuruCreditPacks/{packId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /aiGuruCreditConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    // Server-only — the security boundary for credit purchases. Order amount
    // and credit count are derived from aiGuruCreditPacks at order-create
    // time and read back from this doc at verify time, never from client
    // input, so nobody can tamper with what a payment is worth after the
    // fact (see aiGuruCredits.ts).
    match /aiGuruCreditOrders/{orderId} {
      allow read, write: if false;
    }

    // 📚 SEEKHO MODULE
    match /seekho_courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /seekho_lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /seekho_practice/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /seekho_progress/{progressId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /seekho_subscriptions/{userId} {
      allow read: if request.auth.uid == userId || request.auth.token.admin == true;
      allow write: if false;
    }
    match /seekho_revision_queue/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 🧭 DISCOVER AI
    match /discoverUsage/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
      match /daily/{date} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /discoverHistory/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    match /discoverCache/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ⚙️ APP CONFIG
    match /appModules/{moduleId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /subscriptionPlans/{planId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /appConfig/{configId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    match /featureFlags/{flagId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // ⭐ FEEDBACK & RATINGS — admin-configurable list of rateable features
    match /feedbackFeatures/{featureId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // One doc per student, upsert (student edits their own submission
    // freely); admin reads all for the submissions list + analytics. No
    // delete — same non-destructive posture as educationLeads/dataRightsLog.
    match /feedback/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.userId == request.auth.uid;
      allow read:   if request.auth != null
        && (request.auth.uid == uid || request.auth.token.admin == true);
      allow delete: if false;
    }

    // 🎟️ COUPONS
    match /coupons/{id} {
      allow read, write: if request.auth.token.admin == true;
    }

    // 🎁 REFERRALS
    match /referrals/{referralId} {
      allow read: if request.auth != null
        && (resource.data.referrerId == request.auth.uid
            || resource.data.refereeId == request.auth.uid
            || request.auth.token.admin == true);
      allow write: if false;
    }

    // 👑 ADMINS
    match /admins/{uid} {
      allow read:  if request.auth.token.admin == true;
      allow write: if request.auth.token.superAdmin == true;
    }

    // 🐛 CRASH REPORTS — written by app, read by admin only
    match /crashReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth.token.admin == true;
      allow delete: if false;
    }

    match /affiliateProducts/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // 📸 PHOTOSOLVE USAGE
    match /photoSolveUsage/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
      match /daily/{date} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    // 🎯 EXAM SIMULATOR
    match /examSimulator/{uid} {
      allow read: if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
      match /exams/{examId} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    // 🎙️ VOICE TUTOR USAGE
    match /voiceTutorUsage/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if false;
      match /daily/{date} {
        allow read: if request.auth.uid == uid;
        allow write: if false;
      }
    }

    // 📋 WAITLIST — website "Join With Us" form
    // Anyone (unauthenticated too) can create — no login required on the website.
    // Only admins can read, update, delete.
    match /waitlist/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    // 🔐 DPDP — DATA RIGHTS AUDIT LOG
    // Written only by the exportMyData / eraseMyAccount Cloud Functions
    // (Admin SDK, bypasses these rules) — clients never write their own
    // audit trail, so a user can't fake or erase evidence of a request.
    match /dataRightsLog/{id} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false;
    }

    // 📮 DPDP — GRIEVANCE TRACKER (admin panel only; grievances arrive via
    // support@gloows365.in today, not an in-app form)
    match /grievances/{id} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // 🛡️ DPDP — DATA BREACH INCIDENT LOG (append-only; no deletes so the
    // audit trail can't be tampered with after the fact)
    match /dataBreachLog/{id} {
      allow read, create, update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if false;
    }

    // 🌍 PUBLIC CONFIG — small set of docs that must be readable by anyone,
    // including signed-out visitors on the public website (e.g.
    // publicConfig/grievanceOfficer, published per the DPDP Act, 2023).
    // Unlike appConfig above, no auth is required to read.
    match /publicConfig/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 🎁 PRIZE CLAIMS — VidyaStar Starboard prize fulfillment. Created only
    // by admin (StarboardPayouts.tsx, alongside the existing VCoins-credit
    // batch) when a prize is awarded. A student may read their own docs and
    // submit their delivery details exactly once — the update rule only
    // allows the unclaimed → claimed transition, touching claimInfo/status
    // only, so a student can't alter the prize itself, skip straight to
    // "delivered", or resubmit claimInfo after admin has started fulfilling
    // it. Admin can update anything (status, deliveryInfo) at any time.
    match /prizeClaims/{claimId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && (
        request.auth.token.admin == true
        || (
          resource.data.uid == request.auth.uid
          && resource.data.status == "unclaimed"
          && request.resource.data.status == "claimed"
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["claimInfo", "status"])
        )
      );
      allow delete: if false;
    }

    // 🎓 GLOOWS TUTOR — Phase 1a. Role granted via Firebase custom claim
    // (request.auth.token.role, set by functions/src/tutorAccounts.ts'
    // registerTutorAccount — never a Firestore field, same rule this repo
    // already follows for admins/{uid}) — not enforced here since these
    // are owner-scoped docs; the claim matters for future collections
    // (students-under-tutor, batches, etc.) that need to distinguish
    // TUTOR/TEACHER/COACHING_CENTER, not this one.
    //
    // Profile writes happen directly from the client (no callable) — see
    // functions/src/tutorAccounts.ts's header comment for why.
    match /tutors/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      // ShikshaHub Phase 1 — sessionFee is the one profile field that
      // actually needs a server-side check (it drives what a student
      // gets charged in a later phase), so it's validated right here
      // rather than needing a callable for what's otherwise a plain
      // direct-Firestore-write field (see this match block's original
      // comment above). Split from a single `allow write` into
      // create/update/delete specifically so this check never runs
      // against request.resource.data on a delete, where it doesn't
      // exist. availability isn't validated beyond "the owner wrote
      // it" — same trust level qualification/subjects/bio already have.
      allow create: if request.auth != null && request.auth.uid == uid
        && (!("sessionFee" in request.resource.data)
          || (request.resource.data.sessionFee is int && request.resource.data.sessionFee > 0));
      allow update: if request.auth != null && request.auth.uid == uid
        && (!("sessionFee" in request.resource.data)
          || (request.resource.data.sessionFee is int && request.resource.data.sessionFee > 0));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Verification workflow doc. The tutor never writes this directly —
    // both the "Submitted" transition (submitTutorVerification) and the
    // admin review outcome (reviewTutorVerification) go through the Admin
    // SDK server-side, which bypasses these rules entirely, so this rule
    // only needs to grant the owner read access for the status-timeline UI
    // and otherwise stay closed to client writes.
    match /tutorVerifications/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // 🎓 SHIKSHAHUB — public-safe mirror of verified tutor profiles, written
    // only by syncTutorMarketplaceProfile (functions/src/tutorMarketplace.ts),
    // which runs via the Admin SDK and bypasses these rules entirely. Never
    // phone/email — see tutors/{uid} above for why that stays owner+admin-only.
    match /tutorMarketplaceProfiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // 🧑‍🎓 GLOOWS TUTOR — Phase 1b. A tutor's own manually-added roster
    // entries. Auto-ID docs (a tutor has many students, no natural 1:1
    // key), so ownership is checked via the tutorId field rather than the
    // doc ID — same reasoning as prizeClaims/{claimId} above. No
    // admin-read carve-out: a tutor's roster is private, admin has no
    // product reason to browse it in this phase.
    match /tutorStudents/{studentId} {
      allow read:   if request.auth != null && resource.data.tutorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tutorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.tutorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.tutorId == request.auth.uid;
    }

    // 📚 GLOOWS TUTOR — Phase 1c. A tutor's own batches (named groupings
    // of their tutorStudents). Same owner-scoped-via-field shape as
    // tutorStudents above — this is the "batches" collection that
    // Phase 1a's comment (above, on the custom-claim block) already
    // anticipated. Membership lives on tutorStudents.batchIds, not here;
    // this rule only governs the batch doc itself.
    match /tutorBatches/{batchId} {
      allow read:   if request.auth != null && resource.data.tutorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tutorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.tutorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.tutorId == request.auth.uid;
    }

    // 🗓️ GLOOWS TUTOR — Phase 1d. A tutor's scheduled class sessions, each
    // belonging to one tutorBatch (batchId field, not enforced here — the
    // batch reference is just data, ownership is still checked the same
    // tutorId-field way as tutorBatches/tutorStudents above). "Cancel" is
    // a status update (allow update covers it), not a delete — no
    // hard-delete path this phase.
    match /tutorClasses/{classId} {
      allow read:   if request.auth != null && resource.data.tutorId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tutorId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.tutorId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.tutorId == request.auth.uid;
    }

    // 🎓 SHIKSHAHUB — Phase 1 minimum viable tutor booking. A booking
    // request between one student and one verified tutor — deliberately
    // NOT connected to tutorStudents/tutorBatches/tutorClasses above
    // (those are the tutor's own private CRM for students they already
    // teach; this is the public-marketplace booking relationship — see
    // the Phase 1 architecture audit for why keeping them separate
    // matters). Auto-ID docs, ownership checked via the studentUid/
    // tutorUid fields, same shape as tutorStudents/tutorBatches above.
    //
    // `allow write: if false` is deliberate, not a placeholder — every
    // write (create via requestBooking, the requested->accepted/declined
    // transition via respondToBooking) goes through
    // functions/src/tutorBooking.ts's two callables over the Admin SDK,
    // which bypasses these rules entirely. This is what stops a client
    // from ever posting an arbitrary "accepted" status directly, editing
    // someone else's booking, or reassigning studentUid/tutorUid after
    // the fact — none of that is expressible as a rule a client write
    // could satisfy, so the client path is closed altogether instead.
    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 3 tutor services. Owner-only read (the "My
    // Services" management screen) — students never read this collection
    // directly, they read tutorServicesMarketplace below instead, same
    // owner-doc/public-mirror split as tutors/{uid} vs
    // tutorMarketplaceProfiles/{uid}. `allow write: if false` for the same
    // reason bookings/{id} is closed: every field here needs real
    // validation (positive fee, valid enum, valid date range) that
    // functions/src/tutorServices.ts's createService/updateService/
    // deleteService callables enforce — see that file's header comment.
    match /tutorServices/{serviceId} {
      allow read:  if request.auth != null
        && (resource.data.tutorUid == request.auth.uid || request.auth.token.admin == true);
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 3 public-safe mirror of published services
    // belonging to verified tutors, written only by
    // syncTutorServiceMarketplace (functions/src/tutorServices.ts), which
    // runs via the Admin SDK and bypasses these rules entirely. Same
    // read-open/write-closed shape as tutorMarketplaceProfiles/{uid}.
    match /tutorServicesMarketplace/{serviceId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 4 Instant Help credits. Same shape/reasoning as
    // aiGuruCredits/{uid} above: balance + ledger are Admin-SDK-only, every
    // mutation goes through functions/src/tutorCredits.ts (purchases) or
    // functions/src/instantHelp.ts (per-minute spend) so a client can never
    // grant or spend its own credits.
    match /tutorCredits/{uid} {
      allow read:  if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
      match /transactions/{txId} {
        allow read:                   if request.auth.uid == uid || request.auth.token.admin == true;
        allow create, update, delete: if false;
      }
    }
    match /tutorCreditPacks/{packId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }
    // Server-only — same purchase-tamper-proofing reasoning as
    // aiGuruCreditOrders/{orderId} above.
    match /tutorCreditOrders/{orderId} {
      allow read, write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 4 a tutor's Instant Help earnings. Owner+admin
    // read, Admin-SDK-only write — credited exclusively by
    // functions/src/instantHelp.ts's settleInstantHelpSession().
    match /tutorEarnings/{uid} {
      allow read:  if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
      match /transactions/{txId} {
        allow read:                   if request.auth.uid == uid || request.auth.token.admin == true;
        allow create, update, delete: if false;
      }
    }

    // 🎓 SHIKSHAHUB — Phase 4 Instant Help matching. Same closed-write
    // shape as bookings/{id} — every write (create via requestInstantHelp,
    // the pending->accepted/declined/expired transition via
    // respondToInstantHelpRequest / the scheduled tickInstantHelp) goes
    // through functions/src/instantHelp.ts's Admin-SDK callables, which
    // bypass these rules entirely.
    match /instantHelpRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
      allow write: if false;
    }

    // Same closed-write shape — created by respondToInstantHelpRequest,
    // updated only by endInstantHelpSession / the scheduled
    // tickInstantHelp's billing settlement, both Admin-SDK.
    match /instantHelpSessions/{sessionId} {
      allow read: if request.auth != null
        && (resource.data.studentUid == request.auth.uid || resource.data.tutorUid == request.auth.uid);
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 5 tutor earnings payout. A tutor's saved bank/
    // UPI details — owner+admin read only (contains a bank account
    // number), Admin-SDK-only write via saveTutorPayoutDetails.
    match /tutorPayoutDetails/{uid} {
      allow read:  if request.auth.uid == uid || request.auth.token.admin == true;
      allow write: if false;
    }

    // Same closed-write shape as bookings/{id} — every write (create via
    // requestPayout, pending->approved/rejected via reviewPayoutRequest,
    // approved->paid via markPayoutPaid, pending->cancelled via
    // cancelPayoutRequest) goes through functions/src/tutorPayouts.ts's
    // Admin-SDK callables. Admin read is unrestricted (the review queue
    // needs to see every tutor's requests); tutor read is scoped to their
    // own.
    match /payoutRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.tutorUid == request.auth.uid || request.auth.token.admin == true);
      allow write: if false;
    }

    // Admin-managed commission-rate / minimum-payout / enabled config.
    // Read stays open to any authenticated user — apps/tutor's and
    // apps/tutor-mobile's payouts screens read this directly to show a
    // tutor the current minimum/commission before they request a payout.
    // Write is closed (Phase 5 operational feature): updatePayoutConfig
    // (admin-only callable, functions/src/tutorPayouts.ts) is the only way
    // this doc is ever changed, so input is always server-validated and
    // audited (updatedAt/updatedBy) rather than an unrestricted direct
    // admin client write.
    match /payoutConfig/{docId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — Phase 6 tutor ratings & reviews. Public read (any
    // authenticated user browsing a tutor's marketplace profile) —
    // hidden:true reviews are still readable via a direct/admin query
    // (useTutorReviews' own where(hidden==false) is what actually keeps
    // them out of the public list, same "moderate don't destroy" pattern
    // as everywhere else in this app), Admin-SDK-only write via
    // submitTutorReview/hideTutorReview.
    match /tutorReviews/{reviewId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // 🎓 SHIKSHAHUB — tutor-student messaging phase. One conversation per
    // student-tutor pair: tutorConversations/{studentUid}_{tutorUid} — read
    // scoped to the two participants only (unlike tutorReviews, this is
    // private, not a public marketplace listing). Admin-SDK-only write via
    // sendTutorMessage (create/append)/markConversationRead (unread reset),
    // same closed-write shape every ShikshaHub collection uses. messages is
    // a subcollection, not a top-level one, so its read rule looks up the
    // parent conversation doc's participants via get() rather than
    // duplicating studentUid/tutorUid onto every message.
    match /tutorConversations/{conversationId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.studentUid || request.auth.uid == resource.data.tutorUid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/tutorConversations/$(conversationId)).data.studentUid
              || request.auth.uid == get(/databases/$(database)/documents/tutorConversations/$(conversationId)).data.tutorUid);
        allow write: if false;
      }
    }

  }
}
